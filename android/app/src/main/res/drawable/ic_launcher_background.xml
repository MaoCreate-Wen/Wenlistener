<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background (API 26+): the app's brand indigo gradient
     (seed #4338CA -> seedDeep #1E1B4B from lib/theme/app_colors.dart) with a
     soft green play-accent glow (accentPlay #22C55E) bleeding up from the
     lower-left. Echoes the OLED-dark + accent identity. 108x108dp full-bleed;
     launchers mask it to circle / squircle / rounded-square. Gradients are
     fine here because adaptive icons are API 24+ territory. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Base: diagonal indigo gradient, brighter top-left -> deep bottom-right. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="6" android:startY="2"
                android:endX="104" android:endY="106">
                <item android:offset="0.0" android:color="#FF4F46E5"/>
                <item android:offset="0.55" android:color="#FF4338CA"/>
                <item android:offset="1.0" android:color="#FF1E1B4B"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- Soft green accent glow, lower-left, fading to fully transparent. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="32" android:centerY="80"
                android:gradientRadius="68">
                <item android:offset="0.0" android:color="#5922C55E"/>
                <item android:offset="0.6" android:color="#2622C55E"/>
                <item android:offset="1.0" android:color="#0022C55E"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
